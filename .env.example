# Copy to .env and fill in locally:  cp .env.example .env
# .env is gitignored — never commit API keys.

# Required for live NIM (use one; NVAPI_KEY matches integrate "Bearer nvapi-..." keys)
NVAPI_KEY=
# NVIDIA_API_KEY=

# Operator logging to stderr (timestamps; no secrets or sample text)
SIMULA_VERBOSE=0
# SIMULA_LOG=1

# Stage 4 critic backend: nim | stub | replay | hash
SIMULA_CRITIC_BACKEND=nim

# NVIDIA integrate API (OpenAI-compatible; critics use non-streaming JSON)
SIMULA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
SIMULA_NIM_MODEL=mistralai/mistral-large-3-675b-instruct-2512
SIMULA_CRITIC_MODEL_A=
SIMULA_CRITIC_MODEL_B=

# Rate limit (integrate free tier: up to 40 RPM)
SIMULA_NIM_MAX_RPM=40

# HTTP transport (optional)
SIMULA_HTTP_TIMEOUT_SECONDS=60
SIMULA_HTTP_MAX_RETRIES=3
SIMULA_HTTP_BACKOFF_BASE_SECONDS=2.0
SIMULA_NVIDIA_MAX_TOKENS=16
